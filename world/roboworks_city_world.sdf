<?xml version='1.0'?>
<sdf version='1.9'>
  <world name='roboworks_world'>
    <physics name='default_physics' type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename='gz-sim-physics-system' name='gz::sim::systems::Physics'/>
    <plugin filename='gz-sim-user-commands-system' name='gz::sim::systems::UserCommands'/>
    <plugin filename='gz-sim-sensors-system' name='gz::sim::systems::Sensors'/>
    <plugin filename='gz-sim-scene-broadcaster-system' name='gz::sim::systems::SceneBroadcaster'/>

    <light name='sun' type='directional'>
      <pose>0 0 12 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -1</direction>
    </light>

    <model name='city_ground'>
      <static>true</static>
      <link name='ground_link'>
        <collision name='ground_collision'>
          <geometry><box><size>40 32 0.1</size></box></geometry>
        </collision>
        <visual name='ground_visual'>
          <geometry><box><size>40 32 0.1</size></box></geometry>
          <material>
            <ambient>0.55 0.58 0.62 1</ambient>
            <diffuse>0.55 0.58 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Perimeter walls leave a 36 x 28 m drivable city area. -->
    <model name='city_wall_north'><static>true</static><pose>0 14 0.6 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>40 0.25 1.2</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>40 0.25 1.2</size></box></geometry></visual>
    </link></model>
    <model name='city_wall_south'><static>true</static><pose>0 -14 0.6 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>40 0.25 1.2</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>40 0.25 1.2</size></box></geometry></visual>
    </link></model>
    <model name='city_wall_east'><static>true</static><pose>19 0 0.6 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>0.25 28 1.2</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>0.25 28 1.2</size></box></geometry></visual>
    </link></model>
    <model name='city_wall_west'><static>true</static><pose>-19 0 0.6 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>0.25 28 1.2</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>0.25 28 1.2</size></box></geometry></visual>
    </link></model>

    <!-- Separate dark building blocks leave broad, connected road corridors between them. -->
    <model name='building_north_west'><static>true</static><pose>-12 9 1.0 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>9 5 2</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>9 5 2</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
    </link></model>
    <model name='building_north_center'><static>true</static><pose>0 10 1.0 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>5 6 2</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>5 6 2</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
    </link></model>
    <model name='building_north_east'><static>true</static><pose>12 9 1.0 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>5 5 2</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>5 5 2</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
    </link></model>

    <model name='building_mid_west'><static>true</static><pose>-13 1.5 1.0 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>6 5 2</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>6 5 2</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
    </link></model>
    <model name='building_mid_center'><static>true</static><pose>-3 1.5 1.0 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>4 4 2</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>4 4 2</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
    </link></model>
    <model name='building_mid_east'><static>true</static><pose>12 1.5 1.0 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>6 7 2</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>6 7 2</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
    </link></model>

    <model name='building_south_west'><static>true</static><pose>-11 -8 1.0 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>7 5 2</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>7 5 2</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
    </link></model>
    <model name='building_south_center'><static>true</static><pose>1 -8 1.0 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>10 5 2</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>10 5 2</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
    </link></model>
    <model name='building_south_east'><static>true</static><pose>13 -8 1.0 0 0 0</pose><link name='link'>
      <collision name='collision'><geometry><box><size>6 5 2</size></box></geometry></collision>
      <visual name='visual'><geometry><box><size>6 5 2</size></box></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.03 0.03 0.03 1</diffuse></material></visual>
    </link></model>
  </world>
</sdf>
