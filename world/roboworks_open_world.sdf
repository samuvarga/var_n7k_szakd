<?xml version='1.0'?>
<sdf version='1.9'>
  <world name='roboworks_world'>
    <physics name='default_physics' type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename='gz-sim-physics-system' name='gz::sim::systems::Physics'/>
    <plugin filename='gz-sim-user-commands-system' name='gz::sim::systems::UserCommands'/>
    <plugin filename='gz-sim-sensors-system' name='gz::sim::systems::Sensors'/>
    <plugin filename='gz-sim-scene-broadcaster-system' name='gz::sim::systems::SceneBroadcaster'/>

    <light name='sun' type='directional'>
      <pose>0 0 12 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -1</direction>
    </light>

    <model name='ground_plane'>
      <static>true</static>
      <link name='ground_link'>
        <collision name='ground_collision'>
          <geometry><box><size>40 28 0.1</size></box></geometry>
        </collision>
        <visual name='ground_visual'>
          <geometry><box><size>40 28 0.1</size></box></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name='open_wall_north'>
      <static>true</static>
      <pose>0 10 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>36 0.2 1.0</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>36 0.2 1.0</size></box></geometry></visual>
      </link>
    </model>

    <model name='open_wall_south'>
      <static>true</static>
      <pose>0 -10 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>36 0.2 1.0</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>36 0.2 1.0</size></box></geometry></visual>
      </link>
    </model>

    <model name='open_wall_east'>
      <static>true</static>
      <pose>18 0 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>0.2 20 1.0</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>0.2 20 1.0</size></box></geometry></visual>
      </link>
    </model>

    <model name='open_wall_west'>
      <static>true</static>
      <pose>-18 0 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>0.2 20 1.0</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>0.2 20 1.0</size></box></geometry></visual>
      </link>
    </model>

    <model name='open_obstacle_west'>
      <static>true</static>
      <pose>-6 2.5 0.5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>6 0.25 1.0</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>6 0.25 1.0</size></box></geometry></visual>
      </link>
    </model>

    <model name='open_obstacle_east'>
      <static>true</static>
      <pose>7 -2.5 0.5 0 0 1.57079632679</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>5 0.25 1.0</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>5 0.25 1.0</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>